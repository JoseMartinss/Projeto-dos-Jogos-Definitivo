/* ===== UTILITÁRIOS ===== */

/* Lê um inteiro, rejeitando entradas não numéricas */
int lerNumero() {
    int num;
    while (1) {
        if (scanf("%d", &num) == 1) {
            while (getchar() != '\n');
            return num;
        }
        printf("Entrada invalida! Digite apenas numeros: ");
        while (getchar() != '\n');
    }
}

/* Aguarda qualquer letra para continuar */
static void pausar() {
    char c;
    printf("  Pressione qualquer letra para continuar: ");
    scanf(" %c", &c);
    system("cls");
}

/* Pergunta se o jogador quer jogar novamente; retorna 1 se sim */
static int jogarNovamente() {
    int dnv;
    printf("\n ** DESEJA JOGAR NOVAMENTE? **\n");
    printf("      1 - SIM         2 - NAO\n");
    printf("  Escolha: ");

    while (1) {
        dnv = lerNumero();
        if (dnv == 1 || dnv == 2) break;
        printf("  Escolha 1 ou 2: ");
    }

    if (dnv == 1) system("cls");
    return (dnv == 1);
}

/* ===== JOGO 1: PERGUNTAS E RESPOSTAS ===== */

/* Exibe uma pergunta e retorna 1 se acertou, 0 caso contrário */
static int fazerPergunta(const char *titulo,
                         const char *enunciado,
                         const char *alt1,
                         const char *alt2,
                         const char *alt3,
                         const char *alt4,
                         int correta,
                         const char *feedback_certo,
                         const char *gabarito)
{
    int resposta;

    printf("  +--------------------------------------+\n");
    printf("  |  %-36s|\n", titulo);
    printf("  +--------------------------------------+\n\n");
    printf("  %s\n", enunciado);
    printf("  1 - %s\n  2 - %s\n  3 - %s\n  4 - %s\n", alt1, alt2, alt3, alt4);
    printf("\n  Digite o numero da sua resposta: ");

    resposta = lerNumero();

    if (resposta == correta)
        printf("\n  RESPOSTA CORRETA! %s\n\n", feedback_certo);
    else if (resposta < 1 || resposta > 4)
        printf("\n  RESPOSTA INVALIDA! Resposta certa: %s\n\n", gabarito);
    else
        printf("\n  RESPOSTA INCORRETA! Resposta certa: %s\n\n", gabarito);

    pausar();
    return (resposta == correta);
}

