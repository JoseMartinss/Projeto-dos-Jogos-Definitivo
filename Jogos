/* ===== FUNCAO LER NUMERO - impede digitar letras ===== */
int lerNumero() {
    int num;
    while (1) {
        if (scanf("%d", &num) == 1) {
            while (getchar() != '\n');
            return num;
        }
        printf("Entrada invalida! Digite apenas numeros: ");
        while (getchar() != '\n');
    }
}

