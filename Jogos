/* ===== JOGO 2: COBRA NA CAIXA ===== */

/* Retorna o nome correspondente à escolha */
static const char *nomeCobra(int escolha) {
    static const char *nomes[] = {
        "robertinho do grau",
        "geremias",
        "steave",
        "olavo de carvalho",
        "jalin rabei",
        "ronaldinho gaucho",
        "20comer 70correr"
    };
    return nomes[escolha - 1];
}

void jogoCobraCaixa() {
    do {
        int caixas[5] = {0};
        int escolha1, escolha2, jogadorAtual, caixa, cobra, botao;
        const char *nome1, *nome2;

        printf("Escolha um nome:\n");
        printf("1 - robertinho do grau\n2 - geremias\n3 - steave\n");
        printf("4 - olavo de carvalho\n5 - jalin rabei\n");
        printf("6 - ronaldinho gaucho\n7 - 20comer 70correr\n");

        while (1) {
            printf("\nJogador 1 escolha um numero: ");
            escolha1 = lerNumero();
            if (escolha1 >= 1 && escolha1 <= 7) break;
            printf("Valor invalido!\n");
        }

        while (1) {
            printf("\nJogador 2 escolha um numero: ");
            escolha2 = lerNumero();
            if (escolha2 >= 1 && escolha2 <= 7) break;
            printf("Valor invalido!\n");
        }

        nome1 = nomeCobra(escolha1);
        nome2 = nomeCobra(escolha2);

        printf("\nJogador 1 sera: %s\n", nome1);
        printf("Jogador 2 sera: %s\n", nome2);

        jogadorAtual = rand() % 2 + 1;
        printf("\n%s comeca!\n", (jogadorAtual == 1) ? nome1 : nome2);

        cobra = rand() % 5;
        botao = rand() % 5;
        while (botao == cobra) botao = rand() % 5;

        while (1) {
            const char *nomeAtual = (jogadorAtual == 1) ? nome1 : nome2;
            printf("\n%s escolha uma caixa (1-5): ", nomeAtual);
            caixa = lerNumero();

            if (caixa < 1 || caixa > 5) {
                printf("Escolha invalida!\n");
                continue;
            }

            int pos = caixa - 1;

            if (caixas[pos]) {
                printf("Essa caixa ja foi escolhida!\n");
                continue;
            }

            caixas[pos] = 1;

            if (pos == cobra) {
                printf("Voce encontrou a COBRA! %s perdeu!\n", nomeAtual);
                break;
            } else if (pos == botao) {
                printf("Voce encontrou o BOTAO! %s venceu!\n", nomeAtual);
                break;
            } else {
                printf("Caixa vazia!\n");
            }

            jogadorAtual = (jogadorAtual == 1) ? 2 : 1;
        }

    } while (jogarNovamente());
}

/* ===== JOGO 3: GOUSMAS WAR ===== */

void exibirEstado(int furia[], int ativa[]) {
    printf("\n  +======================+\n");
    printf("  |   ESTADO DO JOGO     |\n");
    printf("  +======================+\n");

    for (int j = 0; j < 2; j++) {
        for (int g = 0; g < 2; g++) {
            int idx = j * 2 + g;
            if (ativa[idx])
                printf("  Jogador %d - Gousma %d: furia %d\n", j + 1, g + 1, furia[idx]);
            else
                printf("  Jogador %d - Gousma %d: DESTRUIDA\n", j + 1, g + 1);
        }
        if (j == 0) printf("  ----------------------\n");
    }

    printf("  +======================+\n\n");
}

void verificarDestruicao(int furia[], int ativa[]) {
    const char *nomes[4] = {
        "Gousma 1 do Jogador 1",
        "Gousma 2 do Jogador 1",
        "Gousma 1 do Jogador 2",
        "Gousma 2 do Jogador 2"
    };

    for (int i = 0; i < 4; i++) {
        if (furia[i] > 5 && ativa[i]) {
            ativa[i] = 0;
            printf("  %s foi DESTRUIDA!\n", nomes[i]);
        }
    }
}

int verificarFimDeJogo(int ativa[]) {
    if (!ativa[0] && !ativa[1]) return 2;
    if (!ativa[2] && !ativa[3]) return 1;
    return 0;
}

int atacar(int furia[], int ativa[], int jogador) {
    int atacante, alvo;
    int minha  = (jogador == 1) ? 0 : 2;
    int inimigo = (jogador == 1) ? 2 : 0;

    printf("  Escolha sua Gousma para atacar (1 ou 2): ");
    while (1) {
        atacante = lerNumero();
        if ((atacante == 1 || atacante == 2) && ativa[minha + atacante - 1]) break;
        if (atacante == 1 || atacante == 2)
            printf("  Essa Gousma esta destruida! Escolha outra: ");
        else
            printf("  Opcao invalida! Escolha 1 ou 2: ");
    }

    printf("  Escolha a Gousma do adversario para atacar (1 ou 2): ");
    while (1) {
        alvo = lerNumero();
        if ((alvo == 1 || alvo == 2) && ativa[inimigo + alvo - 1]) break;
        if (alvo == 1 || alvo == 2)
            printf("  Essa Gousma esta destruida! Escolha outra: ");
        else
            printf("  Opcao invalida! Escolha 1 ou 2: ");
    }

    int iA    = minha   + atacante - 1;
    int iAlvo = inimigo + alvo - 1;
    int antes = furia[iAlvo];

    furia[iAlvo] += furia[iA];

    printf("  Gousma %d atacou! Furia: %d -> %d\n", atacante, antes, furia[iAlvo]);

    verificarDestruicao(furia, ativa);
    return 1;
}

int dividir(int furia[], int ativa[], int jogador) {
    int minha = (jogador == 1) ? 0 : 2;

    /* Verifica se existe alguma Gousma que pode dividir */
    int podeDividir = 0;
    for (int i = 0; i < 2; i++) {
        if (ativa[minha + i] && furia[minha + i] > 1) {
            podeDividir = 1;
            break;
        }
    }

    if (!podeDividir) {
        printf("  Nenhuma Gousma pode dividir!\n");
        return 0;
    }

    int doadora, quantidade;

    printf("  Escolha a Gousma que vai transferir (1 ou 2): ");
    doadora = lerNumero();

    if (doadora != 1 && doadora != 2) {
        printf("  Invalido!\n");
        return 0;
    }

    int iD = minha + doadora - 1;
    int iR = (doadora == 1) ? minha + 1 : minha;

    if (!ativa[iD] || furia[iD] <= 1) {
        printf("  Nao pode usar essa Gousma!\n");
        return 0;
    }

    int maxTransf = furia[iD] - 1;
    printf("  Transferir (1-%d): ", maxTransf);
    quantidade = lerNumero();

    if (quantidade < 1 || quantidade > maxTransf) {
        printf("  Valor invalido!\n");
        return 0;
    }

    if (!ativa[iR]) {
        ativa[iR] = 1;
        printf("  Gousma reviveu!\n");
    }

    furia[iD] -= quantidade;
    furia[iR] += quantidade;

    verificarDestruicao(furia, ativa);
    return 1;
}

void jogoGousmasWar() {
    do {
        int furia[4]  = {1, 1, 1, 1};
        int ativa[4]  = {1, 1, 1, 1};
        int jogadorAtual = 1;

        printf("  +--------------------------------------+\n");
        printf("  |           GOUSMAS WAR                |\n");
        printf("  +--------------------------------------+\n\n");
        printf("  === DESCRICAO ===\n");
        printf("  Dois jogadores controlam 2 Gousmas cada.\n");
        printf("  Cada Gousma comeca com furia 1.\n");
        printf("  Se a furia passar de 5, a Gousma e destruida.\n");
        printf("  Quem ficar sem Gousmas perde!\n\n");
        printf("  Pressione 1 para continuar: ");

        while (lerNumero() != 1);
        system("cls");

        while (1) {
            exibirEstado(furia, ativa);
            printf("  --- Turno do Jogador %d ---\n", jogadorAtual);
            printf("  1 - Atacar\n  2 - Dividir\n  Escolha: ");

            int acao = lerNumero();
            int fezJogada = 0;

            if (acao == 1)
                fezJogada = atacar(furia, ativa, jogadorAtual);
            else if (acao == 2)
                fezJogada = dividir(furia, ativa, jogadorAtual);
            else
                printf("  Opcao invalida!\n");

            int resultado = verificarFimDeJogo(ativa);
            if (resultado != 0) {
                exibirEstado(furia, ativa);
                printf("  *** JOGADOR %d VENCEU! ***\n\n", resultado);
                break;
            }

            if (fezJogada)
                jogadorAtual = (jogadorAtual == 1) ? 2 : 1;
        }

    } while (jogarNovamente());
} 
