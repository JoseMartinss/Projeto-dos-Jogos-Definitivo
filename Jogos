/* ===== JOGO 2: COBRA NA CAIXA ===== */
void jogoCobraCaixa() {
    int escolha1, escolha2, jogadorAtual, caixa, cobra, botao, dnv;
    char nome1[50], nome2[50];

    do {
        int caixas[5] = {0};

        printf("Escolha um nome:\n");
        printf("1 - robertinho do grau\n2 - geremias\n3 - steave\n");
        printf("4 - olavo de carvalho\n5 - jalin rabei\n6 - ronaldinho gaucho\n7 - 20comer 70correr\n");

        while (1) {
            printf("\nJogador 1 escolha um numero: ");
            escolha1 = lerNumero();
            if (escolha1 >= 1 && escolha1 <= 7) break;
            printf("Valor invalido!\n");
        }

        while (1) {
            printf("\nJogador 2 escolha um numero: ");
            escolha2 = lerNumero();
            if (escolha2 >= 1 && escolha2 <= 7) break;
            printf("Valor invalido!\n");
        }

        switch (escolha1) {
            case 1: strcpy(nome1, "robertinho do grau"); break;
            case 2: strcpy(nome1, "geremias"); break;
            case 3: strcpy(nome1, "steave"); break;
            case 4: strcpy(nome1, "olavo de carvalho"); break;
            case 5: strcpy(nome1, "jalin rabei"); break;
            case 6: strcpy(nome1, "ronaldinho gaucho"); break;
            case 7: strcpy(nome1, "20comer 70correr"); break;
        }

        switch (escolha2) {
            case 1: strcpy(nome2, "robertinho do grau"); break;
            case 2: strcpy(nome2, "geremias"); break;
            case 3: strcpy(nome2, "steave"); break;
            case 4: strcpy(nome2, "olavo de carvalho"); break;
            case 5: strcpy(nome2, "jalin rabei"); break;
            case 6: strcpy(nome2, "ronaldinho gaucho"); break;
            case 7: strcpy(nome2, "20comer 70correr"); break;
        }

        printf("\nJogador 1 sera: %s\n", nome1);
        printf("Jogador 2 sera: %s\n", nome2);

        jogadorAtual = rand() % 2 + 1;
        printf("\n%s comeca!\n", (jogadorAtual == 1) ? nome1 : nome2);

        cobra = rand() % 5;
        botao = rand() % 5;
        while (botao == cobra) botao = rand() % 5;

        while (1) {
            printf("\n%s escolha uma caixa (1-5): ", (jogadorAtual == 1) ? nome1 : nome2);
            caixa = lerNumero();

            if (caixa < 1 || caixa > 5) {
                printf("Escolha invalida!\n");
                continue;
            }

            int pos = caixa - 1;

            if (caixas[pos] == 1) {
                printf("Essa caixa ja foi escolhida!\n");
                continue;
            }

            caixas[pos] = 1;

            if (pos == cobra) {
                printf("Voce encontrou a COBRA!\n");
                printf("%s perdeu!\n", (jogadorAtual == 1) ? nome1 : nome2);
                break;
            } else if (pos == botao) {
                printf("Voce encontrou o BOTAO!\n");
                printf("%s venceu!\n", (jogadorAtual == 1) ? nome1 : nome2);
                break;
            } else {
                printf("Caixa vazia!\n");
            }

            jogadorAtual = (jogadorAtual == 1) ? 2 : 1;
        }

        printf("\n\n ** DESEJA JOGAR NOVAMENTE? **\n");
        printf("1- SIM   2- NAO\n");
        dnv = lerNumero();
        if (dnv != 2) system("cls");

    } while (dnv != 2);
}

/* ===== JOGO 3: GOUSMAS WAR ===== */

void exibirEstado(int furia[], int ativa[]) {
    printf("\n  +======================+\n");
    printf("  |   ESTADO DO JOGO     |\n");
    printf("  +======================+\n");

    if (ativa[0] == 1)
        printf("  Jogador 1 - Gousma 1: furia %d\n", furia[0]);
    else
        printf("  Jogador 1 - Gousma 1: DESTRUIDA\n");

    if (ativa[1] == 1)
        printf("  Jogador 1 - Gousma 2: furia %d\n", furia[1]);
    else
        printf("  Jogador 1 - Gousma 2: DESTRUIDA\n");

    printf("  ----------------------\n");

    if (ativa[2] == 1)
        printf("  Jogador 2 - Gousma 1: furia %d\n", furia[2]);
    else
        printf("  Jogador 2 - Gousma 1: DESTRUIDA\n");

    if (ativa[3] == 1)
        printf("  Jogador 2 - Gousma 2: furia %d\n", furia[3]);
    else
        printf("  Jogador 2 - Gousma 2: DESTRUIDA\n");

    printf("  +======================+\n\n");
}

void verificarDestruicao(int furia[], int ativa[]) {
    if (furia[0] > 5 && ativa[0] == 1) {
        ativa[0] = 0;
        printf("  Gousma 1 do Jogador 1 foi DESTRUIDA!\n");
    }
    if (furia[1] > 5 && ativa[1] == 1) {
        ativa[1] = 0;
        printf("  Gousma 2 do Jogador 1 foi DESTRUIDA!\n");
    }
    if (furia[2] > 5 && ativa[2] == 1) {
        ativa[2] = 0;
        printf("  Gousma 1 do Jogador 2 foi DESTRUIDA!\n");
    }
    if (furia[3] > 5 && ativa[3] == 1) {
        ativa[3] = 0;
        printf("  Gousma 2 do Jogador 2 foi DESTRUIDA!\n");
    }
}

int verificarFimDeJogo(int ativa[]) {
    if (ativa[0] == 0 && ativa[1] == 0) return 2;
    if (ativa[2] == 0 && ativa[3] == 0) return 1;
    return 0;
}

void atacar(int furia[], int ativa[], int jogador) {
    int atacante, alvo;

	//mudar aqui se quiser alterar força do ataque
	//essa subtração é pra fazer a escolha selecionar a posição correta no vetor
    int minha_base, base_inimiga;
    if (jogador == 1) { minha_base = 0; base_inimiga = 2; }
    else              { minha_base = 2; base_inimiga = 0; }

    printf("  Escolha sua Gousma para atacar (1 ou 2): ");
    while (1) {
        atacante = lerNumero();
        if (atacante == 1 || atacante == 2) {
            if (ativa[minha_base + atacante - 1] == 1) break;
            else printf("  Essa Gousma esta destruida! Escolha outra: ");
        } else {
            printf("  Opcao invalida! Escolha 1 ou 2: ");
        }
    }

    printf("  Escolha a Gousma do adversario para atacar (1 ou 2): ");
    while (1) {
        alvo = lerNumero();
        if (alvo == 1 || alvo == 2) {
            if (ativa[base_inimiga + alvo - 1] == 1) break;
            else printf("  Essa Gousma esta destruida! Escolha outra: ");
        } else {
            printf("  Opcao invalida! Escolha 1 ou 2: ");
        }
    }

    int indice_atacante = minha_base + atacante - 1;
    int indice_alvo     = base_inimiga + alvo - 1;
    int furia_antes     = furia[indice_alvo];

    furia[indice_alvo] += furia[indice_atacante];

    printf("  Gousma %d do Jogador %d atacou a Gousma %d do adversario!\n", atacante, jogador, alvo);
    printf("  Furia do alvo foi de %d para %d!\n", furia_antes, furia[indice_alvo]);

    verificarDestruicao(furia, ativa);
}

void dividir(int furia[], int ativa[], int jogador) {
    int doadora, quantidade;

    int minha_base;
    if (jogador == 1) minha_base = 0;
    else              minha_base = 2;

    printf("  Escolha a Gousma que vai transferir furia (1 ou 2): ");
    while (1) {
        doadora = lerNumero();
        if (doadora == 1 || doadora == 2) {
            if (ativa[minha_base + doadora - 1] == 0)
                printf("  Essa Gousma esta destruida! Escolha outra: ");
            else if (furia[minha_base + doadora - 1] <= 1)
                printf("  Essa Gousma tem furia 1, nao pode transferir! Escolha outra: ");
            else
                break;
        } else {
            printf("  Opcao invalida! Escolha 1 ou 2: ");
        }
    }

    int indice_doadora, indice_receptora;
    if (doadora == 1) { indice_doadora = minha_base + 0; indice_receptora = minha_base + 1; }
    else              { indice_doadora = minha_base + 1; indice_receptora = minha_base + 0; }

    int max_transferir = furia[indice_doadora] - 1;
    printf("  Gousma doadora tem furia %d. Voce pode transferir entre 1 e %d pontos.\n",
        furia[indice_doadora], max_transferir);
    printf("  Quantos pontos deseja transferir? ");

    while (1) {
        quantidade = lerNumero();
        if (quantidade >= 1 && quantidade <= max_transferir) break;
        printf("  Valor invalido! Transfira entre 1 e %d: ", max_transferir);
    }

    if (ativa[indice_receptora] == 0) {
        ativa[indice_receptora] = 1;
        printf("  Gousma %d REVIVEU!\n", (doadora == 1) ? 2 : 1);
    }

    furia[indice_doadora] -= quantidade;
    furia[indice_receptora] += quantidade;

    printf("  Transferencia feita!\n");
    printf("  Gousma doadora: furia %d | Gousma receptora: furia %d\n",
        furia[indice_doadora], furia[indice_receptora]);

    verificarDestruicao(furia, ativa);
}

void jogoGousmasWar() {
    int dnv;

    do {
        // reinicia o estado do jogo a cada nova partida
        // para alterar a furia inicial de uma gousma, mude o valor na posicao correspondente
        int furia[4] = {1, 1, 1, 1};
        int ativa[4] = {1, 1, 1, 1};
        int jogadorAtual = 1; //quem comeca (1= J1, 2= J2)
        int acao, limpar;

        do {
            printf("  +--------------------------------------+\n");
            printf("  |           GOUSMAS WAR                |\n");
            printf("  +--------------------------------------+\n\n");
            printf("  === DESCRICAO ===\n");
            printf("  Dois jogadores controlam 2 Gousmas cada.\n");
            printf("  Cada Gousma comeca com furia 1.\n");
            printf("  Se a furia passar de 5, a Gousma e destruida.\n");
            printf("  Quem ficar sem Gousmas perde!\n\n");
            printf("  = PRESSIONE 1 PARA CONTINUAR = \n");

            if (scanf("%d", &limpar) != 1) {
                while (getchar() != '\n');
            }
        } while (limpar != 1);

        system("cls");

        while (1) {
            exibirEstado(furia, ativa);

            printf("  --- Turno do Jogador %d ---\n", jogadorAtual);
            printf("  1 - Atacar\n");
            printf("  2 - Dividir\n");
            printf("  Escolha uma acao: ");

            // repete ate o jogador fazer uma jogada valida
            while (1) {
                while (1) {
                    acao = lerNumero();
                    if (acao == 1 || acao == 2) break;
                    printf("  Opcao invalida! Escolha 1 ou 2: ");
                }

                // verifica se o jogador pode dividir antes de executar
                if (acao == 2) {
                    int minha_base = (jogadorAtual == 1) ? 0 : 2;
                    int pode = 0;
                    if (ativa[minha_base + 0] == 1 && furia[minha_base + 0] > 1) pode = 1;
                    if (ativa[minha_base + 1] == 1 && furia[minha_base + 1] > 1) pode = 1;

                    if (pode == 0) {
                        printf("  Nenhuma Gousma pode dividir agora! Escolha outra acao: ");
                        continue;
                    }
                }

                if (acao == 1) atacar(furia, ativa, jogadorAtual);
                else           dividir(furia, ativa, jogadorAtual);
                break;
            }

            int resultado = verificarFimDeJogo(ativa);
            if (resultado != 0) {
                exibirEstado(furia, ativa);
                printf("  *** JOGADOR %d VENCEU! ***\n\n", resultado);
                break;
            }

            if (jogadorAtual == 1) jogadorAtual = 2;
            else                   jogadorAtual = 1;
        }

        printf("\n ** DESEJA JOGAR NOVAMENTE? **\n");
        printf("\n      1- SIM         2- NAO      \n");
        printf("Escolha: ");
        while (1) {
            if (scanf("%d", &dnv) != 1) {
                while (getchar() != '\n');
                printf("  Escolha 1 ou 2: ");
                continue;
            }
            if (dnv == 1 || dnv == 2) break;
            printf("  Opcao invalida! Escolha 1 ou 2: ");
        }
        if (dnv != 2) system("cls");

    } while (dnv != 2);
}
